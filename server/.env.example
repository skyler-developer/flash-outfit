# 闪搭后端环境配置（开发默认值见 src/config.ts，本文件用于覆盖）

# ---- 服务 ----
PORT=3000
# 图片/静态资源对外访问的基础地址（上传接口返回的 URL 前缀）
PUBLIC_BASE_URL=http://localhost:3000

# ---- 数据库 ----
# 开发默认 sqlite（零依赖）；生产改为 mysql 并配置以下连接信息
DB_TYPE=sqlite
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=flash_outfit
# 生产环境务必改为 false 并使用迁移
DB_SYNCHRONIZE=true

# ---- 鉴权 ----
JWT_SECRET=change-me-in-production
# 微信小程序 appid/secret 配置后走真实 code2Session；留空则为 mock 登录模式
# （mock 模式：openid = mock:${x-dev-user header 或 code}，便于本地多用户联调）
WX_APPID=
WX_SECRET=

# ---- 第三方 ----
# 腾讯位置服务 key（逆地理编码），留空时 /geo/reverse 返回降级结果
TENCENT_MAP_KEY=
